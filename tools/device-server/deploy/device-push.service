[Unit]
Description=Biometric terminal push endpoint (pay-safe-ledger)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/device-push.env
ExecStart=/usr/bin/node /opt/device-push/device-server.mjs
WorkingDirectory=/opt/device-push
Restart=always
RestartSec=3

# Runs as a throw-away unprivileged user with a read-only view of the system.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
